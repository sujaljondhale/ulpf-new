FROM ollama/ollama:latest

# Expose Ollama local API port
EXPOSE 11434

ENV OLLAMA_HOST=0.0.0.0 \
    OLLAMA_MODEL=qwen2.5-coder:3b

COPY scripts/entrypoint_ai.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

