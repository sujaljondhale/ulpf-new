# ==============================================================================
# ULPF — Universal Log Pre-processing Framework
# Environment Configuration (Phase 8 — All Variables)
# Copy this file to .env before running locally or in Docker
# ==============================================================================

# ─── Core Application ─────────────────────────────────────────────────────────
ULPF_ENV=production          # development | production
ULPF_DEBUG=false
ULPF_API_HOST=0.0.0.0
ULPF_API_PORT=8000

# ─── Syslog UDP Collector ─────────────────────────────────────────────────────
SYSLOG_UDP_ENABLED=true
SYSLOG_UDP_HOST=0.0.0.0
SYSLOG_UDP_PORT=5140

# ─── Syslog TCP Collector ─────────────────────────────────────────────────────
SYSLOG_TCP_ENABLED=true
SYSLOG_TCP_HOST=0.0.0.0
SYSLOG_TCP_PORT=5141

# ─── Syslog TLS (optional, requires certs) ────────────────────────────────────
SYSLOG_TLS_ENABLED=false
SYSLOG_TLS_PORT=6514
# SYSLOG_TLS_CERTFILE=/certs/server.crt
# SYSLOG_TLS_KEYFILE=/certs/server.key

# ─── File Tail Collector ──────────────────────────────────────────────────────
FILE_COLLECTOR_ENABLED=true
FILE_WATCH_DIR=storage/logs   # Directory scanned for *.log files every 1 second

# ─── Ingestion Queue & Rate Limiting ──────────────────────────────────────────
MAX_EVENTS_PER_SECOND=25000   # Sliding-window EPS cap (drop above this)
INGRESS_QUEUE_MAX_SIZE=50000  # Max queue depth before backpressure drop

# ─── MinIO — Immutable Raw Log S3 Storage ─────────────────────────────────────
MINIO_ENDPOINT=minio:9000     # host:port (no http://)
MINIO_ACCESS_KEY=ulpf_admin
MINIO_SECRET_KEY=ulpf_password_2026
MINIO_BUCKET=ulpf-raw
MINIO_SECURE=false            # true if MinIO is behind HTTPS

# ─── OpenSearch — Normalized Events Search ────────────────────────────────────
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=ulpf-events

# ─── Multi-Provider AI Model Integration ──────────────────────────────────────
# Provider options: ollama | openai | gemini | anthropic | huggingface | local_ml | heuristic
AI_ENABLED=true
AI_PROVIDER=ollama
AI_MODEL_NAME=qwen2.5-coder:3b
AI_FALLBACK_ENABLED=true
AI_TIMEOUT_SECONDS=5.0
AI_ENRICHMENT_ENABLED=false

# Ollama (Default local SLM)
OLLAMA_URL=http://ulpf-ai:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# OpenAI / OpenAI-Compatible (GPT-4o, Groq, vLLM, DeepSeek, LocalAI)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (Gemini 1.5 Flash/Pro, Gemini 2.0)
# GEMINI_API_KEY=AIzaSy...

# Anthropic Claude (Claude 3.5 Sonnet, Claude 3 Haiku)
# ANTHROPIC_API_KEY=sk-ant-...

# Hugging Face Inference API
# HUGGINGFACE_API_KEY=hf_...

# ─── Redpanda / Kafka High-Throughput Streaming Bus ───────────────────────────
REDPANDA_ENABLED=true
REDPANDA_BROKERS=redpanda:9092,localhost:19092
REDPANDA_INPUT_TOPIC=ulpf-raw-ingress
REDPANDA_OUTPUT_TOPIC=ulpf-events-normalized
REDPANDA_ALERTS_TOPIC=ulpf-alerts
REDPANDA_CONSUMER_GROUP=ulpf-workers
REDPANDA_ADMIN_URL=http://redpanda:9644

# ─── Multi-Backend Database & Persistence ─────────────────────────────────────
# Database Type: sqlite (default, embedded) | postgres (enterprise SQL)
DB_TYPE=sqlite
# DATABASE_URL=postgresql://ulpf_user:password@localhost:5432/ulpf_db
# DATABASE_URL=sqlite:///storage/ulpf_metadata.db
DB_SQLITE_PATH=storage/ulpf_metadata.db
DB_POOL_SIZE=10
DB_TIMEOUT=10.0
STORAGE_DIR=storage/raw


