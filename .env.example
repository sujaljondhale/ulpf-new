# Core Application Settings
ULPF_ENV=development
ULPF_DEBUG=false
ULPF_API_HOST=0.0.0.0
ULPF_API_PORT=8000

# MinIO Immutable Raw Log S3 Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ulpf_admin
MINIO_SECRET_KEY=ulpf_password_2026
MINIO_BUCKET=ulpf-raw
MINIO_SECURE=false

# OpenSearch Searchable Normalized Events Store
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=ulpf-events

# Local AI / Ollama Engine
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_ENABLED=true
AI_PROVIDER=huggingface
AI_FALLBACK_ENABLED=false
AI_TIMEOUT_SECONDS=60.0

# Redpanda / Kafka High-Throughput Streaming Bus
REDPANDA_ENABLED=true
REDPANDA_BROKERS=localhost:19092,redpanda:9092
REDPANDA_INPUT_TOPIC=ulpf-raw-ingress
REDPANDA_OUTPUT_TOPIC=ulpf-events-normalized
REDPANDA_ALERTS_TOPIC=ulpf-alerts
REDPANDA_CONSUMER_GROUP=ulpf-workers
REDPANDA_ADMIN_URL=http://localhost:9644

# Persistent Local Metadata Database & Raw Fallback Directory
STORAGE_DIR=storage/raw
DB_SQLITE_PATH=storage/ulpf_metadata.db

HF_TOKEN=hf_your_token_here


# ------------------------------------------------------------------------------
# REDIS IN-MEMORY CACHE & BUFFER
# ------------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
