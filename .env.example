# ==============================================================================
# ULPF — Universal Log Pre-processing Framework
# Environment Configuration Template (Phase 7 Containerized Deployment)
# ==============================================================================

# Core Application Settings
ULPF_ENV=development
ULPF_DEBUG=false
ULPF_API_HOST=0.0.0.0
ULPF_API_PORT=8000

# MinIO Immutable Raw Log S3 Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ulpf_admin
MINIO_SECRET_KEY=ulpf_password_2026
MINIO_BUCKET=ulpf-raw
MINIO_SECURE=false

# OpenSearch Searchable Normalized Events Store
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=ulpf-events

# Local AI / Ollama Engine (Optional Profile)
OLLAMA_URL=http://ulpf-ai:11434
OLLAMA_MODEL=qwen2.5-coder:3b
AI_ENABLED=true

# Persistent Local Metadata Database & Raw Fallback Directory
STORAGE_DIR=storage/raw
DB_SQLITE_PATH=storage/ulpf_metadata.db
