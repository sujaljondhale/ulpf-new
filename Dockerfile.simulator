# ==============================================================================
# ULPF — Dedicated Protocol Simulator & Testing Hub Website
# ==============================================================================

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TESTING_HOST=0.0.0.0 \
    TESTING_PORT=8050 \
    PYTHONPATH=/app/main:/app/testing:/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Non-root user with deterministic UID/GID 10001
RUN groupadd -r -g 10001 appgroup && useradd -r -u 10001 -g appgroup -d /app -s /sbin/nologin appuser
RUN mkdir -p /app/storage/raw /app/storage/logs && chown -R appuser:appgroup /app

COPY --chown=appuser:appgroup . .

USER appuser

EXPOSE 8050

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
    CMD curl -f -s http://127.0.0.1:8050/ || exit 1

CMD ["python", "testing/run_testing.py"]
